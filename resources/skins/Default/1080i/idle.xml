<?xml version="1.0" encoding="UTF-8"?>
<window>
    <controls>
        <!-- Background fill: white runtime-generated texture tinted via colordiffuse.
             Doubles as the solid-color idle and the letterbox fill for image mode. -->
        <control type="image" id="200">
            <left>0</left>
            <top>0</top>
            <width>100%</width>
            <height>100%</height>
            <aspectratio>scale</aspectratio>
        </control>

        <!-- Image idle, one control per scaling mode; service shows exactly one.
             contain -> keep, cover -> zoom, stretch -> scale -->
        <control type="image" id="201">
            <left>0</left>
            <top>0</top>
            <width>100%</width>
            <height>100%</height>
            <aspectratio>keep</aspectratio>
            <visible>false</visible>
        </control>
        <control type="image" id="202">
            <left>0</left>
            <top>0</top>
            <width>100%</width>
            <height>100%</height>
            <aspectratio>scale</aspectratio>
            <visible>false</visible>
        </control>
        <control type="image" id="203">
            <left>0</left>
            <top>0</top>
            <width>100%</width>
            <height>100%</height>
            <aspectratio>zoom</aspectratio>
            <visible>false</visible>
        </control>

        <!-- PoC debug overlay (toggleable in addon settings) -->
        <control type="label" id="300">
            <left>20</left>
            <top>1040</top>
            <width>100%</width>
            <height>40</height>
            <font>font13</font>
            <textcolor>FFFFFFFF</textcolor>
            <align>left</align>
            <aligny>center</aligny>
            <visible>false</visible>
        </control>
    </controls>
</window>
